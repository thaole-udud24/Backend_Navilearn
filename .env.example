NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/navilearn
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# [ASSUMPTION] mailer/storage/ai providers not specified in BRD; env left as placeholders
MAIL_FROM=no-reply@navilearn.local
STORAGE_UPLOAD_DIR=uploads
AI_PROVIDER_API_KEY=change_me
