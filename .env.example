NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/navilearn
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# [ASSUMPTION] mailer/storage providers not specified in BRD; env left as placeholders
MAIL_FROM=no-reply@navilearn.local
STORAGE_UPLOAD_DIR=uploads
# Lấy key tại https://aistudio.google.com/apikey — để trống thì integrations/ai dùng câu trả lời giả lập
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- ACC (account & auth) ---
FRONTEND_URL=http://localhost:5173
# Để trống SMTP_HOST thì mail chỉ được ghi vào log (OTP đọc trong log server khi chạy dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NaviLearn <no-reply@navilearn.local>
OTP_EXPIRES_MINUTES=10
OTP_RESEND_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
STORAGE_UPLOAD_DIR=uploads
